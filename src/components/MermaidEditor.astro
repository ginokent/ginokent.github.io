---
// Mermaid Editor の埋め込みコンポーネント。ja / en 両ルート (tools/mermaid-editor.astro と
// [lang]/tools/mermaid-editor.astro) から locale を受け取って共有する。
//
// 設計: 文言は上流から無改変同期した i18n 辞書 (getMessages) で引く。固定ラベル
// (ヘッダ・ペイン見出し・ツールバーのボタン) はビルド時に locale で確定してサーバ描画し、
// 動的な文言 (連番ラベル・トースト・テンプレートボタン) はクライアントの bootstrap が
// data-locale から locale を読んで描画する。親サイトはパスベース (/en/) でロケールが
// 決まるため、エディタ内に言語トグルは置かない (言語切替はヘッダの lang-switch が担う)。
import { getMessages, type Locale } from '../scripts/mermaid-editor/core/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = getMessages(locale).chrome;
---

<!--
  mermaid-editor リポジトリの index.html (body) を移植したマークアップ。
  サイト全体の <body>/<header>/<main> は BaseLayout が持つため、エディタ独自の
  それらの殻は外し、.mermaid-editor コンテナへ閉じ込めている。固定文言は locale で
  サーバ描画し、ロジックは src/scripts/mermaid-editor/ (上流から無改変同期) を参照する。
-->
<article class="mermaid-editor" data-locale={locale}>
  <header class="me-header">
    <h1>Mermaid Editor</h1>
    <p>{m.subtitle}</p>
  </header>
  <div class="me-panes">
    <!-- 左: Mermaid テキスト (正本) -->
    <section class="pane">
      <h2>{m.sourceTitle}</h2>
      <textarea id="source" spellcheck="false"></textarea>
    </section>
    <!-- 右: レンダリング図 + オーバーレイ編集層 -->
    <section class="pane">
      <div class="pane-head">
        <h2>{m.diagramTitle}</h2>
        <div class="toolbar">
          <button id="add-element" type="button" title={m.addTitle}>{m.add}</button>
          <button id="fmt" type="button" title={m.fmtTitle}>{m.fmt}</button>
          <button id="direction" type="button" data-diagram="flowchart" title={m.directionTitle}>{m.direction}</button>
          <button id="autonumber" type="button" data-diagram="sequence" title={m.autonumberTitle}>{m.autonumber(false)}</button>
          <button id="undo" type="button" title={m.undoTitle}>{m.undo}</button>
          <button id="redo" type="button" title={m.redoTitle}>{m.redo}</button>
          <span class="toolbar-sep"></span>
          <button id="copy-code" type="button" title={m.copyTitle}>{m.copy}</button>
          <button id="export-svg" type="button" title={m.svgTitle}>{m.svg}</button>
          <button id="export-png" type="button" title={m.pngTitle}>{m.png}</button>
          <button id="share-url" type="button" title={m.shareTitle}>{m.share}</button>
          <span class="toolbar-sep"></span>
          <span class="toolbar-label">{m.templatesLabel}</span>
          <span id="templates" class="templates"></span>
        </div>
      </div>
      <div id="error" class="error" hidden></div>
      <div id="stage">
        <div id="diagram"></div>
        <div id="overlay"></div>
      </div>
    </section>
  </div>
</article>

<script>
  // mermaid-editor/src/main.ts を移植した bootstrap。ロジックは上流から無改変同期した
  // モジュールを参照し、CSS はこのコンポーネントの <style> 側で扱う。ロケールは固定文言の
  // サーバ描画で確定済みなので、ここでは locale を data 属性から読んで Editor と動的文言
  // (連番ラベル・トースト・テンプレート) にのみ流す。スタンドアロン版と違い言語の判定・
  // 永続化・トグルは持たない (親サイトがパスでロケールを決めるため)。
  import { Editor } from '../scripts/mermaid-editor/editor';
  import { load } from '../scripts/mermaid-editor/core/persist';
  import { TEMPLATES } from '../scripts/mermaid-editor/core/templates';
  import { getMessages, defaultLocale, isLocale } from '../scripts/mermaid-editor/core/i18n';

  const $ = <T extends HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`element #${id} not found`);
    return el as T;
  };

  // ロケールは .mermaid-editor の data-locale から読む (ページごとに確定)
  const rawLocale = document.querySelector<HTMLElement>('.mermaid-editor')?.dataset.locale ?? '';
  const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
  const msg = getMessages(locale);

  // 図種に応じてツールバーの図種別ボタン (data-diagram) を出し分け、連番ボタンの状態を更新する
  function syncToolbar(): void {
    const type = editor.diagramType();
    for (const btn of document.querySelectorAll<HTMLElement>('[data-diagram]')) {
      btn.style.display = btn.dataset.diagram === type ? '' : 'none';
    }
    const an = $('autonumber');
    an.textContent = msg.chrome.autonumber(editor.autonumberEnabled());
    an.setAttribute('aria-pressed', String(editor.autonumberEnabled()));
  }

  const editor = new Editor(
    {
      source: $<HTMLTextAreaElement>('source'),
      diagram: $('diagram'),
      overlay: $('overlay'),
      stage: $('stage'),
      error: $('error'),
    },
    syncToolbar, // 再構築 (図種変化を含む) ごとにツールバーを更新
    { locale }, // メニュー・ヒント等の UI 文言ロケール
  );

  $('add-element').addEventListener('click', () => void editor.addElement());
  $('fmt').addEventListener('click', () => void editor.format());
  $('direction').addEventListener('click', () => void editor.cycleDirection());
  $('autonumber').addEventListener('click', () => void editor.toggleAutonumber());
  $('undo').addEventListener('click', () => void editor.undo());
  $('redo').addEventListener('click', () => void editor.redo());

  const copyBtn = $('copy-code');
  copyBtn.addEventListener('click', async () => {
    const ok = await editor.copyCode();
    const original = copyBtn.textContent;
    copyBtn.textContent = ok ? msg.chrome.copyDone : msg.chrome.copyFailed;
    window.setTimeout(() => (copyBtn.textContent = original), 1200);
  });
  $('export-svg').addEventListener('click', () => editor.saveSvg());
  $('export-png').addEventListener('click', () => void editor.savePng());

  const shareBtn = $('share-url');
  shareBtn.addEventListener('click', async () => {
    const original = shareBtn.textContent;
    try {
      await navigator.clipboard.writeText(location.href);
      shareBtn.textContent = msg.chrome.shareDone;
    } catch {
      shareBtn.textContent = msg.chrome.copyFailed;
    }
    window.setTimeout(() => (shareBtn.textContent = original), 1200);
  });

  // テンプレートボタン: ラベルは i18n から引く。確認の上で全文を置換する (置換は Undo で戻せる)
  const templatesEl = $('templates');
  for (const t of TEMPLATES) {
    const label = msg.templateLabel[t.key] ?? t.label;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = label;
    btn.title = msg.chrome.templateButtonTitle(label);
    btn.addEventListener('click', () => {
      if (window.confirm(msg.chrome.templateConfirm(label))) {
        void editor.replaceAll(t.text);
      }
    });
    templatesEl.append(btn);
  }

  // URL ハッシュ / localStorage に保存があれば復元、無ければ既定テンプレート
  void editor.setText(load() ?? TEMPLATES[0].text);
</script>

<style is:global>
  /*
    mermaid-editor/src/style.css を移植し、サイト全体 (BaseLayout) との衝突を避けるため
    すべてのセレクタを .mermaid-editor 配下へ再スコープしたもの。
    上流の裸セレクタ body / header h1 / header p / main は衝突するため、それぞれ
    破棄 (body) ・コンテナ配下 (header→.me-header, main→.me-panes) へ置換している。
    .hit / .menu / .inline-input 等は overlay.ts が実行時に動的生成する要素のため
    Astro の scoped style では当たらない。ゆえに is:global で global に置く必要がある。
    エディタは light テーマ前提の自己完結ウィジェットとして色を固定し、サイトの
    dark テーマでも内部の可読性を保つ。
  */
  /*
    このツールはテキストと図を縦積みする作業領域なので、ブログ記事向けの既定幅
    (.container の max-width: 720px) では窮屈になる。とくに参加者の多いシーケンス図は
    図ペインがページ幅いっぱいに広がれるほど収まりやすい。スタンドアロン版 (body 全幅)
    に合わせ、.mermaid-editor を含むページの main.container だけ幅上限を撤廃して全幅に
    する (.container の左右パディングがそのまま余白になる)。他ページ (記事・OCR 等) には
    影響させない。
  */
  main.container:has(.mermaid-editor) {
    max-width: none;
  }

  /*
    地 (ページ背景) に乗る見出し・説明・ペイン見出しはサイトのテーマ色に追従させる
    (ダークテーマで暗文字に潰れないため)。白背景ウィジェット内の文字色は各セレクタで
    個別に固定しているので、ここで全体に色を被せない。
  */
  .mermaid-editor {
    font-family: system-ui, sans-serif;
  }

  .mermaid-editor .me-header h1 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
    color: var(--text);
  }

  .mermaid-editor .me-header p {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .mermaid-editor .me-panes {
    display: grid;
    grid-template-columns: 1fr; /* 上: テキストエディタ / 下: 図 の縦積み */
    gap: 1rem;
    align-items: start;
  }

  .mermaid-editor .pane h2 {
    font-size: 0.9rem;
    margin: 0 0 0.5rem;
  }

  .mermaid-editor .pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mermaid-editor .toolbar {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .mermaid-editor .toolbar button {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid #ccc;
    border-radius: 5px;
    background: #fff;
    color: #1a1a1a;
    cursor: pointer;
  }

  .mermaid-editor .toolbar button:hover {
    background: #f1f5f9;
  }

  .mermaid-editor .toolbar-sep {
    width: 1px;
    align-self: stretch;
    background: #e2e8f0;
    margin: 0 0.15rem;
  }

  .mermaid-editor .toolbar-label {
    align-self: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .mermaid-editor .templates {
    display: inline-flex;
    gap: 0.35rem;
  }

  .mermaid-editor #source {
    width: 100%;
    height: 240px;
    box-sizing: border-box;
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    resize: vertical;
    background: #fff;
    color: #1a1a1a;
  }

  /* 構文エラー表示 */
  .mermaid-editor .error {
    margin-bottom: 0.5rem;
    padding: 0.5rem 0.7rem;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 6px;
    color: #b91c1c;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    white-space: pre-wrap;
    max-height: 8rem;
    overflow: auto;
  }

  /* 図とオーバーレイの基準コンテナ */
  .mermaid-editor #stage {
    position: relative;
    border: 1px solid #eee;
    border-radius: 6px;
    padding: 0.5rem;
    overflow: auto;
    background: #fff;
  }

  .mermaid-editor #overlay {
    position: absolute;
    inset: 0;
    pointer-events: none; /* 子のヒット領域のみ受け取る */
  }

  /* 編集可能ノードのヒット領域 */
  .mermaid-editor .hit {
    position: absolute;
    pointer-events: auto;
    cursor: pointer;
    border: 1.5px dashed transparent;
    border-radius: 4px;
    box-sizing: border-box;
  }

  .mermaid-editor .hit:hover {
    border-color: #2563eb;
    background: rgba(37, 99, 235, 0.08);
  }

  /* メッセージ矢印のクリック帯: ホバーで矢印を青い半透明バンドで包む */
  .mermaid-editor .msg-line-hit {
    border: none;
  }
  .mermaid-editor .msg-line-hit:hover {
    border: none;
    background: rgba(37, 99, 235, 0.25);
  }

  /* ライフライン (縦線) のクリック帯: ホバーで縦に青く強調 */
  .mermaid-editor .lifeline-hit {
    border: none;
  }
  .mermaid-editor .lifeline-hit:hover {
    border: none;
    background: rgba(37, 99, 235, 0.18);
  }

  /* エッジのクリック用太線 (透明、ホバーで薄く可視化) */
  .mermaid-editor .edge-hit {
    pointer-events: stroke;
    cursor: pointer;
  }

  .mermaid-editor .edge-hit:hover {
    stroke: rgba(37, 99, 235, 0.25) !important;
  }

  /* ノード選択モード: 対象を選ぶカーソルと始点の強調 */
  .mermaid-editor #overlay.picking .hit {
    cursor: crosshair;
  }

  .mermaid-editor .hit.pick-source {
    border-color: #16a34a;
    background: rgba(22, 163, 74, 0.12);
  }

  /* メッセージ追加の起点マーカー (ここから矢印が伸びる)。指定座標を中心に置く */
  .mermaid-editor .pick-start {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: #16a34a;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1.5px #16a34a;
    pointer-events: none;
    z-index: 26;
  }

  .mermaid-editor .pick-hint {
    /* 選択モード中の状態表示。縦長の図でスクロールしても常に見えるようビューポート下端中央に
       固定する。上端固定だとサイトの sticky ヘッダ (z-index:100) に覆われて見えなくなるため下端へ */
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    background: #16a34a;
    color: #fff;
    font-size: 0.8rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    white-space: nowrap;
    z-index: 1000;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }

  /* コンテキストメニュー */
  .mermaid-editor .menu {
    position: absolute;
    pointer-events: auto; /* overlay の pointer-events:none 継承を打ち消す */
    z-index: 20;
    min-width: 140px;
    background: #fff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
    padding: 0.25rem;
    display: flex;
    flex-direction: column;
  }

  .mermaid-editor .menu-item {
    text-align: left;
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    border: none;
    background: transparent;
    color: #1a1a1a;
    border-radius: 5px;
    cursor: pointer;
  }

  .mermaid-editor .menu-item:hover {
    background: #eff6ff;
  }

  /* サブメニューを開いている親項目を、どれを展開中か分かるよう常時ハイライトする */
  .mermaid-editor .menu-item.is-open {
    background: #eff6ff;
  }

  /* 無効な項目: 操作不可であることを色とカーソルで示す (理由は note を常時表示) */
  .mermaid-editor .menu-item--disabled {
    color: #9ca3af;
    cursor: not-allowed;
  }

  .mermaid-editor .menu-item--disabled:hover {
    background: transparent;
  }

  /* ラベル下の補足。無効化の理由などをスマホでも見えるよう常時表示する */
  .mermaid-editor .menu-item__note {
    display: block;
    font-size: 0.7rem;
    color: #9ca3af;
    margin-top: 0.1rem;
  }

  /* インライン編集の入力欄 */
  .mermaid-editor .inline-input {
    position: absolute;
    pointer-events: auto; /* overlay の pointer-events:none 継承を打ち消す */
    z-index: 25;
    box-sizing: border-box;
    text-align: center;
    font-size: 0.85rem;
    border: 1.5px solid #2563eb;
    border-radius: 4px;
    padding: 0 2px;
    background: #fff;
    color: #1a1a1a;
  }

  /* ラベルの複数行編集 (Shift+Enter で改行)。内容に合わせて高さを伸ばす */
  .mermaid-editor textarea.inline-input {
    resize: none;
    overflow: hidden;
    font-family: inherit;
    line-height: 1.3;
    padding: 1px 3px;
  }
</style>
